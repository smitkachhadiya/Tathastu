<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    tools:ignore="SpeakableTextPresentCheck"
    tools:context=".User_Package.Blood_Section.B_Edit_detail_page">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/BTN_back"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="start"
            android:layout_marginStart="@dimen/_5sdp"
            android:backgroundTint="@color/blood_donation"
            android:src="@drawable/round_arrow_back_24"
            app:fabCustomSize="@dimen/_30sdp"
            app:fabSize="mini"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />


        <TextView
            android:layout_width="@dimen/_270sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/kanit_medium"
            android:text="Edit Your Request"
            android:layout_marginStart="@dimen/_15sdp"
            android:textColor="@color/blood_donation"
            android:textSize="@dimen/_20sdp" />


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:hint="Enter Full Name"
            app:boxStrokeColor="@color/blood_donation"
            app:boxStrokeErrorColor="@color/err_color"
            app:cursorColor="@color/blood_donation"
            app:boxCornerRadiusBottomStart="@dimen/_15sdp"
            app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopStart="@dimen/_15sdp"
            android:textColorHint="#49454F"
            app:hintTextColor="@color/blood_donation"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:inputType="textAutoComplete"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:hint="Enter Patient Age"
            app:boxStrokeColor="@color/blood_donation"
            app:boxStrokeErrorColor="@color/err_color"
            app:cursorColor="@color/blood_donation"
            app:boxCornerRadiusBottomStart="@dimen/_15sdp"
            app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopStart="@dimen/_15sdp"
            app:cursorErrorColor="@color/err_color"
            app:hintTextColor="@color/blood_donation"
            app:prefixTextColor="@color/blood_donation"
            android:textColorHint="#49454F"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:maxLength="2"
                android:inputType="numberDecimal"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:hint="Enter Patient Weight"
            app:boxStrokeColor="@color/blood_donation"
            app:boxStrokeErrorColor="@color/err_color"
            app:cursorColor="@color/blood_donation"
            app:boxCornerRadiusBottomStart="@dimen/_15sdp"
            app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopStart="@dimen/_15sdp"
            app:cursorErrorColor="@color/err_color"
            app:hintTextColor="@color/blood_donation"
            app:prefixTextColor="@color/blood_donation"
            android:textColorHint="#49454F"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:hint="Required Blood group"
            app:boxStrokeColor="@color/blood_donation"
            app:boxStrokeErrorColor="@color/err_color"
            app:cursorColor="@color/blood_donation"
            app:boxCornerRadiusBottomStart="@dimen/_15sdp"
            app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopStart="@dimen/_15sdp"
            app:cursorErrorColor="@color/err_color"
            app:boxBackgroundColor="@color/white"
            app:endIconTint="@color/blood_donation"
            app:hintTextColor="@color/blood_donation"
            tools:ignore="HardcodedText"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:hintEnabled="true"
            android:textColorHint="#49454F"
            app:expandedHintEnabled="true"
            android:clickable="false">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/txt_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/black"
                tools:ignore="SpeakableTextPresentCheck"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:hint="Enter Mobile No."
            app:boxStrokeColor="@color/blood_donation"
            app:boxStrokeErrorColor="@color/err_color"
            app:cursorColor="@color/blood_donation"
            app:boxCornerRadiusBottomStart="@dimen/_15sdp"
            app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopStart="@dimen/_15sdp"
            app:cursorErrorColor="@color/err_color"
            app:hintTextColor="@color/blood_donation"
            android:textColorHint="#49454F"
            app:prefixTextColor="@color/blood_donation"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_mno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:inputType="phone"
                android:maxLength="13"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"/>

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/txt_getlocation"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_12sdp"
                app:itemIconSize="@dimen/_100sdp"
                android:tint="@color/blood_donation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.489"
                app:srcCompat="@drawable/b_location" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout3"
                android:layout_width="281dp"
                android:layout_height="wrap_content"
                android:hint="Enter Address"
                app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
                app:boxCornerRadiusBottomStart="@dimen/_15sdp"
                app:boxCornerRadiusTopEnd="@dimen/_15sdp"
                app:boxCornerRadiusTopStart="@dimen/_15sdp"
                app:boxStrokeColor="@color/blood_donation"
                app:boxStrokeErrorColor="@color/err_color"
                app:cursorColor="@color/blood_donation"
                app:cursorErrorColor="@color/err_color"
                app:hintTextColor="@color/blood_donation"
                android:textColorHint="#49454F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/txt_getlocation"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:prefixTextColor="@color/black"
                tools:ignore="HardcodedText,MissingConstraints">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:inputType="textImeMultiLine"
                    android:lines="3"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_13sdp"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:hint="Enter Description"
            app:boxStrokeColor="@color/blood_donation"
            app:boxStrokeErrorColor="@color/err_color"
            app:cursorColor="@color/blood_donation"
            app:cursorErrorColor="@color/err_color"
            app:hintTextColor="@color/blood_donation"
            app:prefixTextColor="@color/blood_donation"
            tools:ignore="HardcodedText"
            app:boxCornerRadiusBottomStart="@dimen/_15sdp"
            android:textColorHint="#49454F"
            app:boxCornerRadiusBottomEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopEnd="@dimen/_15sdp"
            app:boxCornerRadiusTopStart="@dimen/_15sdp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:inputType="textMultiLine"
                android:lines="3"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"/>

        </com.google.android.material.textfield.TextInputLayout>




        <Button
            android:id="@+id/BTN_save"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="SAVE"
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/white"
            android:backgroundTint="@color/blood_donation"
            android:layout_marginTop="@dimen/_25sdp"/>
    </LinearLayout>
</ScrollView>

</LinearLayout>